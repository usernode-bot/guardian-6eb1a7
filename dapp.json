{
  "name": "Guardian",
  "secrets": [
    {
      "key": "PLATFORM_BASE_URL",
      "description": "Base URL of the Usernode Social Vibecoding platform shell, used to build chromeless deep-link redirects for shared links.",
      "required": false,
      "default": "https://social-vibecoding.usernodelabs.org"
    },
    {
      "key": "APP_SLUG",
      "description": "This app's slug on the Usernode platform, used in chromeless deep-link redirects (#app/<slug>/full).",
      "required": false,
      "default": "guardian"
    },
    {
      "key": "NODE_RPC_URL",
      "description": "http://usernode-node:3000",
      "private": true
    }
  ],
  "tests": [
    {
      "name": "Messages page loads (default)",
      "path": "/",
      "expectText": "Messages"
    },
    {
      "name": "Conversation list renders",
      "path": "/",
      "expectText": "Alice Chen"
    },
    {
      "name": "Unread badge displays",
      "path": "/",
