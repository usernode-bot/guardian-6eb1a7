      "path": "/?shot=scroll-fab#/conversation/conv_1",
      "expectSelector": "[data-testid=\"scroll-to-latest-fab\"]"
    },
    {
      "name": "Scroll-to-latest FAB is painted on screen when scrolled up in direct messages",
      "path": "/?shot=scroll-fab#/conversation/conv_1",
      "expectSelector": "[data-testid=\"scroll-to-latest-fab\"].is-visible[data-fab-onscreen=\"true\"]"
    },
    {
      "name": "Scroll-to-latest FAB hides when direct message thread sits at the bottom",
      "path": "/?shot=scroll-fab-bottom#/conversation/conv_1",
      "expectSelector": "[data-testid=\"scroll-to-latest-fab\"][data-fab-onscreen=\"false\"]"
    },
    {
      "name": "Scroll-to-latest FAB renders in group chat view",
      "path": "/?shot=scroll-fab#/group/group_1",
      "expectSelector": "[data-testid=\"scroll-to-latest-fab\"]"
