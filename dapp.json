  "tests": [
    {
      "name": "Messages page loads (default)",
      "path": "/",
      "expectText": "Messages"
    },
    {
      "name": "Conversation list renders",
      "path": "/",
      "expectText": "Alice Chen"
    },
    {
      "name": "Unread badge displays",
